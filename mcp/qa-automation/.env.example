# Copy to .env and adjust. FastMCP loads .env automatically (pydantic-settings).
# 完整配置说明见仓库根 README.md「配置」一节；带 [必填] 的项必须配置，其余可选。

# --- 日志/传输（FastMCP）---
# Log level for FastMCP's own logging output: DEBUG, INFO, WARNING, ERROR, CRITICAL
FASTMCP_LOG_LEVEL=INFO

# Default transport: stdio, http, sse, streamable-http
FASTMCP_TRANSPORT=stdio

# HTTP transport bind address and port (used with transport=http)
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000

# --- 被测系统（[必填]）---
# 被测系统根地址（登录接口、验证码、工作台页面均基于此拼接）。
# 不提供示例业务域名：请替换为你的实际环境地址，例如 https://scm.example.com
SCM_BASE_URL=https://your-scm-host.example.com

# --- 浏览器接管 ---
# 接管目标（browser_connect 默认 attach 的浏览器调试端口）；默认 9222，可改其他端口
# CDP_URL=http://127.0.0.1:9222

# --- 视觉/光标 ---
# 虚拟光标/目标高亮服务级默认开关（工具未显式传 visualize 时生效）
# VISUAL_CURSOR_ENABLED=false

# --- 数据目录（config.py）---
# 服务私有数据（accounts.json / .auth）固定在 MCP 项目目录 mcp/qa-automation，
# 不随插件包或使用方项目变化；需整体迁移时用 PROJECT_DIR 覆盖（绝对路径）。
# PROJECT_DIR=D:\path\to\qa-automation
# 资产根：截图/导出用例/下载/证据等生成文件保存到"使用该插件的项目目录"。
# 由使用方注入 WORK_DIR（Agent 客户端环境变量或 mcp.json env）；未配置回退 PROJECT_DIR。
# WORK_DIR=D:\path\to\user-project
# DOWNLOAD_DIR=downloads            # download_file 默认落盘目录（相对 WORK_DIR）
# OUTPUT_DIR=output_testcases       # export_session 导出用例 JSON/Excel 目录（相对 WORK_DIR）
# EVIDENCE_DIR=evidence_assets      # 证据/截图目录（相对 WORK_DIR，可选）

# --- 时序/重试调优（config.py，慢环境整体放大改一处即可）---
# ELEMENT_WAIT_TIMEOUT_MS=6000      # 元素定位等待超时
# ACTION_RETRY_ATTEMPTS=3           # 定位-执行统一重试次数
# ACTION_RETRY_BACKOFF_MS=500       # 重试间隔
# OBSERVE_WAIT_MS=1500              # 交互后浮层/消息观察窗口
# CONNECT_RETRY_ATTEMPTS=3          # CDP 首次连接退避重试次数
# CONNECT_RETRY_BACKOFF_MS=1500     # CDP 重试初始间隔（指数退避 x2）

# --- Python 运行时 ---
# PYTHONUNBUFFERED=1                # 日志即时输出（stdio 传输下建议开启）
