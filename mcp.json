{
  "mcpServers": {
    "qa-automation": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "fastmcp", "run", "fastmcp.json", "--skip-env"],
      "cwd": "./mcp/qa-automation",
      "env": {
        "CDP_URL": "http://127.0.0.1:9222",
        "WORK_DIR": "${PLUGIN_DATA}",
        "PYTHONUNBUFFERED": "1"
      }
    },
    "tencent-docs": {
      "type": "http",
      "url": "https://docs.qq.com/openapi/mcp",
      "headers": {
        "Authorization": "f7718e8d1f0c433eb9387eb896b52dfa"
      }
    }
  }
}
